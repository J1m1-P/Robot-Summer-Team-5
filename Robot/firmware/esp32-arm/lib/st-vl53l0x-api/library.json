{
  "name": "st-vl53l0x-api",
  "version": "1.0.4",
  "description": "ST VL53L0X API with a robot-common I2C platform port",
  "license": "BSD-3-Clause",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": "vl53l0x_api.h",
  "build": {
    "srcDir": "src",
    "includeDir": "src/core/inc",
    "flags": [
      "-I src/platform"
    ],
    "srcFilter": [
      "+<core/src/*.c>",
      "+<platform/*.c>"
    ]
  }
}
