[Unit]
Description=Teletubby YOLO detector
# Only needs the local disk (venv + model files) and device nodes (serial,
# GPIO, USB camera) -- not networking, cloud-init, or console login. A plain
# service unit auto-gets Requires=/After=basic.target, which on this Pi is
# gated behind the whole cloud-init chain (~3s) via sysinit.target --
# DefaultDependencies=no drops that implicit pull-in so only the explicit
# After=local-fs.target below applies (see `systemd-analyze critical-chain
# tubby.service`). We re-add the shutdown ordering by hand since opting out
# also drops that.
DefaultDependencies=no
After=local-fs.target
Requires=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
User=admin5
Group=admin5
WorkingDirectory=/home/admin5/robotSummer/Robot-Summer-Team-5/Robot/firmware/Rpi/computerVision

# Wait for the USB webcam to actually enumerate before starting, instead of a
# blind sleep. USB cameras get a stable symlink under /dev/v4l/by-id/ that only
# exists once the device is plugged in and ready -- so we poll for any *video*
# node there, every 0.5s for up to 60s, and start the instant it appears.
# (We deliberately do NOT wait on /dev/video0: on the Pi that's an internal
# device that's always present and is NOT the webcam.)
ExecStartPre=/bin/bash -c 'for i in $(seq 1 120); do ls /dev/v4l/by-id/*video* >/dev/null 2>&1 && exit 0; sleep 0.5; done; exit 1'

# Use the venv's python directly (no need to "source activate").
ExecStart=/home/admin5/robotSummer/ComputerVision/venv/bin/python /home/admin5/robotSummer/Robot-Summer-Team-5/Robot/firmware/Rpi/computerVision/tubby_simple.py

# If the detector crashes (camera hiccup, etc.), bring it back automatically.
Restart=on-failure
RestartSec=5

# Send the script's stdout/stderr to the journal so you can read logs later.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=local-fs.target